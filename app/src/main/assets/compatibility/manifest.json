{
  "manifest_version": 2,
  "name": "Time Casket Public Resource Compatibility",
  "version": "1.5.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "compatibility@roco.local"
    }
  },
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons",
    "webRequest",
    "webRequestBlocking",
    "https://17roco.qq.com/*",
    "https://web2.17roco.qq.com/*",
    "https://res.17roco.qq.com/swf/*",
    "https://res.17roco.qq.com/libs/*",
    "https://res.17roco.qq.com/conf/*",
    "https://res.17roco.qq.com/res/*",
    "https://res.17roco.qq.com/plugins/*",
    "https://res.17roco.qq.com/activity/*",
    "https://res.17roco.qq.com/apps/*",
    "https://res.17roco.qq.com/video/*",
    "https://res.17roco.qq.com/preloader.swf*",
    "https://res.17roco.qq.com/main.swf*",
    "https://res.17roco.qq.com/ver.config*",
    "https://res.17roco.qq.com/Global.xml*",
    "https://res.17roco.qq.com/preloadlist.xml*"
  ],
  "content_scripts": [
    {
      "matches": ["https://17roco.qq.com/*", "https://web2.17roco.qq.com/*"],
      "js": ["game-view.js", "game-control.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://17roco.qq.com/*", "https://web2.17roco.qq.com/*"],
      "js": ["game-http.js", "player-options.js", "audio-unlock.js", "engine-signals.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "background": {
    "scripts": [
      "public-swf.js",
      "socket-background.js"
    ]
  }
}
