{
  "manifest_version": 2,
  "name": "Roco Probe Diagnostics",
  "version": "1.0.0",
  "browser_specific_settings": {"gecko": {"id": "diagnostics@roco.local"}},
  "permissions": ["webRequest", "nativeMessaging", "geckoViewAddons", "https://17roco.qq.com/*", "https://*.17roco.qq.com/*", "http://17roco.qq.com/*", "http://*.17roco.qq.com/*"],
  "background": {"scripts": ["privacy.js", "background.js"]}
}
